# =====================================================
# Bags2Rent — Variáveis de ambiente
# =====================================================
# Copie este arquivo para `.env.local` e preencha com seus valores reais.
# `.env.local` já está no .gitignore — NUNCA faça commit dele.
#
# As variáveis `VITE_*` são lidas pelo frontend (Vite).
# As variáveis sem prefixo são lidas pelas Supabase Edge Functions
# e devem ser configuradas com `supabase secrets set NOME=valor`.
# =====================================================


# ----- Frontend (Vite) -----

# URL do projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co

# Chave anon (public) do Supabase
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# (Opcional) Cloudflare — usado pelo botão "Limpar Cache"
VITE_CLOUDFLARE_ZONE_ID=
VITE_CLOUDFLARE_API_TOKEN=


# ----- Edge Functions (Supabase Secrets) -----
# Configure com `supabase secrets set NOME=valor` no diretório do projeto.
# O frontend NÃO tem acesso a essas variáveis — elas ficam server-side.

# === Asaas — Ambiente SANDBOX (testes) ===
# https://sandbox.asaas.com (sem cobrança real)
ASAAS_API_KEY_SANDBOX=
ASAAS_API_URL_SANDBOX=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN_SANDBOX=

# === Asaas — Ambiente PRODUÇÃO (real) ===
# https://api.asaas.com (cobranças válidas)
ASAAS_API_KEY_PRODUCTION=
ASAAS_API_URL_PRODUCTION=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN_PRODUCTION=

# === Fallback legado (caso as específicas por ambiente não existam) ===
# Recomendado manter vazio em produção. Usado apenas para retrocompatibilidade.
ASAAS_API_KEY=
ASAAS_API_URL=
ASAAS_WEBHOOK_TOKEN=

# === Resend (e-mails transacionais) ===
RESEND_API_KEY=re_...

# === Cloudflare (chamada server-side do Edge) ===
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=